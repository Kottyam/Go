rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /goShops/{id} {
      allow read, write: if request.auth != null;
    }
    match /goOwners/{id} {
      allow read, write: if request.auth != null && request.auth.uid == id;
    }
    match /goCodes/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
